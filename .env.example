# ============================================================
# VeriHire AI - environment configuration (copy to .env)
# All AI processing is LOCAL. No paid AI API keys are required.
# ============================================================

# ---------- Express backend ----------
PORT=4000
NODE_ENV=development
# Must be set to a long random value in production (required there).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# ---------- MongoDB ----------
# If MongoDB is not running and MONGODB_MEMORY_FALLBACK=true, the backend
# automatically starts a local in-memory MongoDB (mongodb-memory-server).
MONGODB_URI=mongodb://127.0.0.1:27017/verihire_ai
MONGODB_MEMORY_FALLBACK=true

# ---------- Local AI engine (Python / FastAPI) ----------
AI_ENGINE_URL=http://127.0.0.1:8000
# Optional: enable a local sentence-transformers style model (off by default).
LOCAL_EMBEDDINGS_ENABLED=false

# ---------- File uploads ----------
MAX_UPLOAD_MB=5
UPLOAD_DIR=uploads

# ---------- Job discovery (real public job boards only) ----------
# Discovery is the only feature that uses the internet: it reads the public
# Greenhouse/Lever job boards listed in backend/src/config/jobSources.json.
# No vacancy is ever invented and applications are never auto-submitted.
JOB_DISCOVERY_ENABLED=true
# Minutes before a board may be re-checked (each refresh is polite and serialized).
JOB_REFRESH_MINUTES=360
JOB_PROVIDER_TIMEOUT_MS=30000
# Maximum postings stored per board (early-career titles first, then newest).
JOB_MAX_PER_SOURCE=60
# Maximum stored vacancies considered by the matcher per request.
JOB_MATCH_LIMIT=300

# ---------- Admin bootstrap (seed script) ----------
ADMIN_EMAIL=admin@verihire.local
ADMIN_PASSWORD=Admin123!ChangeMe
ADMIN_NAME=VeriHire Administrator
