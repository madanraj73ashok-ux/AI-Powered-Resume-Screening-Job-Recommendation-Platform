# ============================================================
# VeriHire AI - environment configuration (copy to .env)
# All AI processing is LOCAL. No paid AI API keys are required.
# ============================================================

# ---------- Express backend ----------
PORT=4000
NODE_ENV=development
# Must be set to a long random value in production (required there).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# ---------- MongoDB ----------
# If MongoDB is not running and MONGODB_MEMORY_FALLBACK=true, the backend
# automatically starts a local in-memory MongoDB (mongodb-memory-server).
MONGODB_URI=mongodb://127.0.0.1:27017/verihire_ai
MONGODB_MEMORY_FALLBACK=true

# ---------- Local AI engine (Python / FastAPI) ----------
AI_ENGINE_URL=http://127.0.0.1:8000
# Optional: enable a local sentence-transformers style model (off by default).
LOCAL_EMBEDDINGS_ENABLED=false

# ---------- File uploads ----------
MAX_UPLOAD_MB=5
UPLOAD_DIR=uploads

# ---------- Admin bootstrap (seed script) ----------
ADMIN_EMAIL=admin@verihire.local
ADMIN_PASSWORD=Admin123!ChangeMe
ADMIN_NAME=VeriHire Administrator
